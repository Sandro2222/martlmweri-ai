
GROQ_API_KEY=YOURKEY
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000

# Copy this file to .env and fill in a real key. NEVER commit .env.
#
# You only need ONE provider. Gemini is the default and is recommended:
# it is markedly better at Georgian and its free tier is not capped at
# 8,000 tokens/minute the way Groq's is.

# --- Gemini (default, recommended) -------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default: gemini-3.5-flash
# gemini-3.6-flash is slightly stronger but its free tier has a tight
# requests-per-DAY limit that runs out quickly.
# GEMINI_MODEL=gemini-3.5-flash

# --- Groq (fallback) ----------------------------------------------------------
# Get a free key at https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Force a provider regardless of which keys are set: "gemini" or "groq".
# Leave unset to auto-select (Gemini first).
# PROVIDER=gemini

# Local dev server port (server.js). Vercel sets this itself.
# PORT=3000

